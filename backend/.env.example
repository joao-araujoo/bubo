NODE_ENV=development
PORT=3001
SERVICE_NAME=bubo-api
APP_RELEASE=development
INSTANCE_COUNT=1
MONGODB_URI=mongodb://localhost:27017/bubo
JWT_SECRET=replace-with-a-long-random-secret-at-least-24-characters

# MongoDB pool
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_MAX_IDLE_TIME_MS=60000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000

# Redis is optional for a single local API process. Set REDIS_URL to enable shared cache and rate limits.
# Multiple API instances require Redis and should set REDIS_REQUIRED=true.
REDIS_URL=
REDIS_REQUIRED=false
REDIS_KEY_PREFIX=bubo:development
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=1500
REDIS_CACHE_TTL_MS=3600000

# Comma-separated allowed browser origins
CLIENT_URL=http://localhost:5173,http://localhost:8080
TRUST_PROXY=false
BODY_LIMIT=1mb
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=30
BOOK_SEARCH_RATE_LIMIT=60

# Operational metrics. Development enables them by default.
METRICS_ENABLED=true
METRICS_TOKEN=

# Optional external error collector
ERROR_REPORTING_URL=
ERROR_REPORTING_TOKEN=
ERROR_REPORTING_TIMEOUT_MS=3000

# AI provider: auto | openai | gemini
# At least one provider key is required for Deep Review validation.
# Without a key, the API reports the coach as unavailable and never creates a local score.
AI_PROVIDER=auto
AI_TIMEOUT_MS=30000

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google Books (optional; Open Library is also queried for metadata enrichment)
GOOGLE_BOOKS_API_KEY=

# Catalog search cache
BOOK_SEARCH_CACHE_TTL_MS=21600000
BOOK_SEARCH_MEMORY_CACHE_TTL_MS=900000

# Required only for the optional idempotent demonstration seed
SEED_DEMO_EMAIL=demo@bubo.local
SEED_DEMO_PASSWORD=choose-a-private-local-demo-password
SEED_RESET_PASSWORD=false

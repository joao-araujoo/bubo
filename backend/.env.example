NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://localhost:27017/bubo
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated allowed browser origins
CLIENT_URL=http://localhost:5173,http://localhost:8080
TRUST_PROXY=false
BODY_LIMIT=1mb
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=30

# AI provider: auto | openai | gemini
# At least one provider key is required for Deep Review validation.
# Without a key, the API reports the coach as unavailable and never creates a local score.
AI_PROVIDER=auto
AI_TIMEOUT_MS=30000

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google Books (optional; Open Library is also queried for metadata enrichment)
GOOGLE_BOOKS_API_KEY=

# Optional idempotent demonstration seed
SEED_DEMO_EMAIL=demo@bubo.local
SEED_DEMO_PASSWORD=BuboDemo123!
SEED_RESET_PASSWORD=false

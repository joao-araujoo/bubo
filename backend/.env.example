NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://localhost:27017/bubo
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated allowed browser origins
CLIENT_URL=http://localhost:5173,http://localhost:8080
TRUST_PROXY=false
BODY_LIMIT=1mb
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=30

# AI provider: auto | openai | gemini | local
# auto prefers OpenAI, then Gemini, and finally the local evaluator.
AI_PROVIDER=auto
AI_ALLOW_LOCAL_FALLBACK=true
AI_TIMEOUT_MS=25000

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google Books (optional; requests may work with public quota)
GOOGLE_BOOKS_API_KEY=

# Optional idempotent demonstration seed
SEED_DEMO_EMAIL=demo@bubo.local
SEED_DEMO_PASSWORD=BuboDemo123!
SEED_RESET_PASSWORD=false

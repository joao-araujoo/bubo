<?xml version="1.0" encoding="utf-8"?>
<!-- Small streak widget (Duolingo-style): flame + number, caption, Bubo peeking from the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="@drawable/bubo_scene_lavender" android:clipToOutline="true">
  <ImageView android:id="@+id/bubo_deco" android:layout_width="match_parent" android:layout_height="match_parent"
    android:scaleType="centerCrop" android:src="@drawable/bubo_deco_lavender" android:importantForAccessibility="no" />
  <ImageView android:id="@+id/bubo_mascot" android:layout_width="match_parent" android:layout_height="140dp"
    android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="-38dp"
    android:scaleType="fitCenter" android:src="@drawable/bubo_widget_welcome" android:contentDescription="Bubo" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="11dp" android:paddingEnd="10dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical">
      <FrameLayout android:layout_width="26dp" android:layout_height="26dp">
        <ImageView android:id="@+id/bubo_flame" android:layout_width="match_parent" android:layout_height="match_parent"
          android:src="@drawable/bubo_flame_off_lavender" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/bubo_alert" android:layout_width="13dp" android:layout_height="13dp" android:layout_gravity="bottom|end"
          android:src="@drawable/bubo_flame_alert" android:visibility="gone" android:importantForAccessibility="no" />
      </FrameLayout>
      <TextView android:id="@+id/bubo_number" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="4dp" android:text="Bubo" android:textSize="26sp" android:includeFontPadding="false"
        android:fontFamily="@font/bubo_black" android:textColor="@color/bubo_scene_lavender_number" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/bubo_message" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="2dp" android:text="Seu Bubo mora aqui" android:textSize="12sp" android:fontFamily="@font/bubo_bold"
      android:textColor="@color/bubo_scene_lavender_muted" android:maxLines="2" android:ellipsize="end" />
  </LinearLayout>
</FrameLayout>

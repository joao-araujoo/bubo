<?xml version="1.0" encoding="utf-8"?>
<!-- Wide streak widget: "N dias de sequência", caption, week checks and Bubo on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="@drawable/bubo_scene_lavender" android:clipToOutline="true">
  <ImageView android:id="@+id/bubo_deco" android:layout_width="match_parent" android:layout_height="match_parent"
    android:scaleType="centerCrop" android:src="@drawable/bubo_deco_lavender_wide" android:importantForAccessibility="no" />
  <ImageView android:id="@+id/bubo_mascot" android:layout_width="140dp" android:layout_height="150dp"
    android:layout_gravity="bottom|end" android:layout_marginEnd="-8dp" android:layout_marginBottom="-40dp"
    android:scaleType="fitCenter" android:src="@drawable/bubo_widget_welcome" android:contentDescription="Bubo" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="118dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical">
      <FrameLayout android:layout_width="24dp" android:layout_height="24dp">
        <ImageView android:id="@+id/bubo_flame" android:layout_width="match_parent" android:layout_height="match_parent"
          android:src="@drawable/bubo_flame_off_lavender" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/bubo_alert" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="bottom|end"
          android:src="@drawable/bubo_flame_alert" android:visibility="gone" android:importantForAccessibility="no" />
      </FrameLayout>
      <TextView android:id="@+id/bubo_number" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="5dp" android:text="Bubo" android:textSize="18sp" android:includeFontPadding="false"
        android:fontFamily="@font/bubo_black" android:textColor="@color/bubo_scene_lavender_number" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/bubo_message" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="3dp" android:text="Seu Bubo mora aqui" android:textSize="13sp" android:fontFamily="@font/bubo_bold"
      android:textColor="@color/bubo_scene_lavender_muted" android:maxLines="1" android:ellipsize="end" />
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/bubo_week" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/bubo_wl0" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:textSize="10sp" android:fontFamily="@font/bubo_bold" android:textColor="@color/bubo_scene_lavender_muted" />
        <ImageView android:id="@+id/bubo_wd0" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="3dp"
          android:src="@drawable/bubo_week_lavender" />
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/bubo_wl1" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:textSize="10sp" android:fontFamily="@font/bubo_bold" android:textColor="@color/bubo_scene_lavender_muted" />
        <ImageView android:id="@+id/bubo_wd1" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="3dp"
          android:src="@drawable/bubo_week_lavender" />
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/bubo_wl2" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:textSize="10sp" android:fontFamily="@font/bubo_bold" android:textColor="@color/bubo_scene_lavender_muted" />
        <ImageView android:id="@+id/bubo_wd2" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="3dp"
          android:src="@drawable/bubo_week_lavender" />
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/bubo_wl3" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:textSize="10sp" android:fontFamily="@font/bubo_bold" android:textColor="@color/bubo_scene_lavender_muted" />
        <ImageView android:id="@+id/bubo_wd3" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="3dp"
          android:src="@drawable/bubo_week_lavender" />
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/bubo_wl4" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:textSize="10sp" android:fontFamily="@font/bubo_bold" android:textColor="@color/bubo_scene_lavender_muted" />
        <ImageView android:id="@+id/bubo_wd4" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="3dp"
          android:src="@drawable/bubo_week_lavender" />
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/bubo_wl5" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:textSize="10sp" android:fontFamily="@font/bubo_bold" android:textColor="@color/bubo_scene_lavender_muted" />
        <ImageView android:id="@+id/bubo_wd5" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="3dp"
          android:src="@drawable/bubo_week_lavender" />
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/bubo_wl6" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:textSize="10sp" android:fontFamily="@font/bubo_bold" android:textColor="@color/bubo_scene_lavender_muted" />
        <ImageView android:id="@+id/bubo_wd6" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="3dp"
          android:src="@drawable/bubo_week_lavender" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>

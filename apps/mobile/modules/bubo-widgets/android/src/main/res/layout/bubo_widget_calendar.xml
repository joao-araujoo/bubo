<?xml version="1.0" encoding="utf-8"?>
<!-- Month calendar widget: active-day runs on the left; streak, caption and Bubo on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="@drawable/bubo_scene_lavender" android:clipToOutline="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.4"
      android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="10dp" android:paddingBottom="10dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/bubo_ch0" style="@style/BuboCalendarHeader" />
        <TextView android:id="@+id/bubo_ch1" style="@style/BuboCalendarHeader" />
        <TextView android:id="@+id/bubo_ch2" style="@style/BuboCalendarHeader" />
        <TextView android:id="@+id/bubo_ch3" style="@style/BuboCalendarHeader" />
        <TextView android:id="@+id/bubo_ch4" style="@style/BuboCalendarHeader" />
        <TextView android:id="@+id/bubo_ch5" style="@style/BuboCalendarHeader" />
        <TextView android:id="@+id/bubo_ch6" style="@style/BuboCalendarHeader" />
      </LinearLayout>
      <LinearLayout android:id="@+id/bubo_cr0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/bubo_c0" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c1" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c2" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c3" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c4" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c5" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c6" style="@style/BuboCalendarDay" />
      </LinearLayout>
      <LinearLayout android:id="@+id/bubo_cr1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/bubo_c7" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c8" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c9" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c10" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c11" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c12" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c13" style="@style/BuboCalendarDay" />
      </LinearLayout>
      <LinearLayout android:id="@+id/bubo_cr2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/bubo_c14" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c15" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c16" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c17" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c18" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c19" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c20" style="@style/BuboCalendarDay" />
      </LinearLayout>
      <LinearLayout android:id="@+id/bubo_cr3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/bubo_c21" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c22" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c23" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c24" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c25" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c26" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c27" style="@style/BuboCalendarDay" />
      </LinearLayout>
      <LinearLayout android:id="@+id/bubo_cr4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/bubo_c28" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c29" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c30" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c31" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c32" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c33" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c34" style="@style/BuboCalendarDay" />
      </LinearLayout>
      <LinearLayout android:id="@+id/bubo_cr5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/bubo_c35" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c36" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c37" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c38" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c39" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c40" style="@style/BuboCalendarDay" />
        <TextView android:id="@+id/bubo_c41" style="@style/BuboCalendarDay" />
      </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
      <ImageView android:id="@+id/bubo_mascot" android:layout_width="match_parent" android:layout_height="130dp"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="-38dp"
        android:scaleType="fitCenter" android:src="@drawable/bubo_widget_welcome" android:contentDescription="Bubo" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="12dp" android:paddingEnd="6dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:orientation="horizontal" android:gravity="center_vertical">
      <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
        <ImageView android:id="@+id/bubo_flame" android:layout_width="match_parent" android:layout_height="match_parent"
          android:src="@drawable/bubo_flame_off_lavender" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/bubo_alert" android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="bottom|end"
          android:src="@drawable/bubo_flame_alert" android:visibility="gone" android:importantForAccessibility="no" />
      </FrameLayout>
          <TextView android:id="@+id/bubo_number" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:text="Bubo" android:textSize="28sp" android:includeFontPadding="false"
            android:fontFamily="@font/bubo_black" android:textColor="@color/bubo_scene_lavender_number" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/bubo_message" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginTop="2dp" android:gravity="center_horizontal" android:text="Seu Bubo mora aqui" android:textSize="12sp"
          android:fontFamily="@font/bubo_bold" android:textColor="@color/bubo_scene_lavender_muted" android:maxLines="2" android:ellipsize="end" />
      </LinearLayout>
    </FrameLayout>
  </LinearLayout>
</FrameLayout>

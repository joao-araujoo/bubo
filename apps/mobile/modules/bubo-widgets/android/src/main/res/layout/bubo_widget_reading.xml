<?xml version="1.0" encoding="utf-8"?>
<!-- Continue-reading widget: streak header, a white book card and Bubo peeking on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="@drawable/bubo_scene_lavender" android:clipToOutline="true">
  <ImageView android:id="@+id/bubo_deco" android:layout_width="match_parent" android:layout_height="match_parent"
    android:scaleType="centerCrop" android:src="@drawable/bubo_deco_lavender_wide" android:importantForAccessibility="no" />
  <ImageView android:id="@+id/bubo_mascot" android:layout_width="124dp" android:layout_height="136dp"
    android:layout_gravity="bottom|end" android:layout_marginEnd="-8dp" android:layout_marginBottom="-36dp"
    android:scaleType="fitCenter" android:src="@drawable/bubo_widget_welcome" android:contentDescription="Bubo" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical">
      <FrameLayout android:layout_width="22dp" android:layout_height="22dp">
        <ImageView android:id="@+id/bubo_flame" android:layout_width="match_parent" android:layout_height="match_parent"
          android:src="@drawable/bubo_flame_off_lavender" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/bubo_alert" android:layout_width="11dp" android:layout_height="11dp" android:layout_gravity="bottom|end"
          android:src="@drawable/bubo_flame_alert" android:visibility="gone" android:importantForAccessibility="no" />
      </FrameLayout>
      <TextView android:id="@+id/bubo_number" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="4dp" android:text="Bubo" android:textSize="18sp" android:includeFontPadding="false"
        android:fontFamily="@font/bubo_black" android:textColor="@color/bubo_scene_lavender_number" android:maxLines="1" />
      <TextView android:id="@+id/bubo_message" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="8dp" android:text="Seu Bubo mora aqui" android:textSize="12sp" android:fontFamily="@font/bubo_bold"
        android:textColor="@color/bubo_scene_lavender_muted" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/bubo_card" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
      android:layout_marginTop="8dp" android:layout_marginEnd="92dp" android:background="@drawable/bubo_card"
      android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp">
      <ImageView android:id="@+id/bubo_cover" android:layout_width="40dp" android:layout_height="58dp" android:layout_marginEnd="10dp"
        android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="Capa do livro" />
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/bubo_title" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="Sua próxima leitura" android:textSize="14sp" android:fontFamily="@font/bubo_black"
          android:textColor="@color/bubo_card_text" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/bubo_pages" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="Adicione um livro à sua estante" android:textSize="11sp" android:fontFamily="@font/bubo_regular"
          android:textColor="@color/bubo_card_muted" android:maxLines="1" android:ellipsize="end" />
        <ProgressBar android:id="@+id/bubo_progress" style="?android:attr/progressBarStyleHorizontal"
          android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="6dp"
          android:max="100" android:progressDrawable="@drawable/bubo_progress" android:visibility="gone" />
        <TextView android:id="@+id/bubo_action" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginTop="5dp" android:text="Abrir Bubo" android:textSize="11sp" android:fontFamily="@font/bubo_bold"
          android:textColor="@color/bubo_card_fill" android:maxLines="1" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>

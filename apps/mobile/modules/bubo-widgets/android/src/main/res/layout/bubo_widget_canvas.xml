<?xml version="1.0" encoding="utf-8"?>
<!-- Every Bubo widget is drawn on a Canvas with Plus Jakarta Sans (RemoteViews ignore @font). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="@drawable/bubo_widget_surface" android:clipToOutline="true">
  <ImageView android:id="@+id/bubo_canvas" android:layout_width="match_parent" android:layout_height="match_parent"
    android:scaleType="fitXY" android:contentDescription="Bubo" />
</FrameLayout>

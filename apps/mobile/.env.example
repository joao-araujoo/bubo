# Copy to apps/mobile/.env (gitignored). EXPO_PUBLIC_* values are embedded in the app bundle:
# never put secrets here (Gemini, database and auth secrets live only in the API).
# Android emulator: use http://10.0.2.2:8787 ; physical device: http://<your-LAN-IP>:8787
EXPO_PUBLIC_API_URL=http://localhost:8787

# Optional remote push setup. The EAS project UUID is public metadata, not an API key.
# BUBO_EAS_PROJECT_ID=
# GOOGLE_SERVICES_JSON=C:/private/bubo-google-services.json
# FCM service-account/APNs private credentials go only in Expo credentials, never in this file.

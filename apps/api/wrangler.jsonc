{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bubo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "development"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "bubo"
    }
  ]
}

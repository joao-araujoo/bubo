# Copy to apps/api/.dev.vars (gitignored) for `npm run dev:api`. Never commit real values.
# Empty DATABASE_URL → local embedded Postgres (PGlite). Set it → wrangler dev + Neon.
DATABASE_URL=
# ≥ 32 chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# LAN address (http://<your-ip>:8787) so e-mailed links open on a phone.
BETTER_AUTH_URL=http://localhost:8787
# Optional: where e-mail pictures load from (mail apps cannot reach a LAN address; ADR-041).
EMAIL_ART_BASE_URL=https://bubo-api.bubo-api.workers.dev
GEMINI_API_KEY=
# Optional locally (reset links are logged in development); required in production.
RESEND_API_KEY=
EMAIL_FROM=
# Server-only Google Books identification; keyless calls may return 429.
GOOGLE_BOOKS_API_KEY=
# Contact for Open Library; no key required for Open Library or BrasilAPI.
CATALOG_CONTACT_EMAIL=
# HTTPS public base URL for the MEDIA bucket. Empty keeps external cover fallback.
MEDIA_PUBLIC_URL=

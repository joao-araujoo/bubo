# Public ports
BUBO_PORT=8080
API_PORT=3001

# Runtime identity. APP_RELEASE should be the deployed commit/tag.
SERVICE_NAME=bubo-api
APP_RELEASE=development
INSTANCE_COUNT=1

# Required. Use a long random value with at least 24 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-24-characters

# MongoDB connection pool. Tune according to the database plan and number of API replicas.
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_MAX_IDLE_TIME_MS=60000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000

# Shared Redis. The Compose stack provides the internal host `redis` without exposing a public port.
# Redis becomes mandatory automatically when INSTANCE_COUNT is greater than one.
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=true
REDIS_KEY_PREFIX=bubo:production
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=1500
REDIS_CACHE_TTL_MS=3600000

# AI provider: auto | openai | gemini
# Deep Review requires at least one real provider key. Without a key, the rest of the app works,
# but AI validation remains explicitly unavailable and never generates a local score.
AI_PROVIDER=auto
AI_TIMEOUT_MS=30000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional Google Books quota key. Invalid or exhausted keys automatically retry without the key.
GOOGLE_BOOKS_API_KEY=

# Book search cache. Memory is local, Redis is shared and MongoDB remains the persistent fallback.
BOOK_SEARCH_CACHE_TTL_MS=21600000
BOOK_SEARCH_MEMORY_CACHE_TTL_MS=900000

# Required only when running the optional demonstration seed.
SEED_DEMO_EMAIL=demo@bubo.local
SEED_DEMO_PASSWORD=choose-a-private-local-demo-password
SEED_RESET_PASSWORD=false

# API protection (requests per 15-minute window). Counters are shared through Redis when configured.
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=30
BOOK_SEARCH_RATE_LIMIT=60

# Operational metrics.
# Metrics are enabled automatically outside production. In production they are disabled by default.
# When enabled in production, METRICS_TOKEN must contain at least 24 characters.
METRICS_ENABLED=false
METRICS_TOKEN=

# Optional external error collector. The backend sends sanitized JSON for HTTP 5xx and process failures.
# Production requires an authorization token with at least 16 characters.
ERROR_REPORTING_URL=
ERROR_REPORTING_TOKEN=
ERROR_REPORTING_TIMEOUT_MS=3000

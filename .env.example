# Mobile
EXPO_PUBLIC_API_URL=http://localhost:8787

# API / Cloudflare secrets
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8787

# Password reset e-mail (server-side only)
# Production: configure both values below as Worker secrets/variables.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Bubo <conta@seu-dominio.com>
# Local development only: when true, reset links are printed to the Worker console.
AUTH_DEV_LOG_RESET_URLS=true

# AI provider keys stay server-side
OPENAI_API_KEY=
GEMINI_API_KEY=

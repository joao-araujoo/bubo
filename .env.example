# Bubo — environment variables (TEMPLATE ONLY — this file is committed: never put real values here).
# Real values go in gitignored files:
#   - API secrets  → apps/api/.dev.vars   (see apps/api/.dev.vars.example)
#   - public values → apps/mobile/.env     (see apps/mobile/.env.example)

# ---- API (Cloudflare Worker) ----
# development | preview | production
APP_ENV=development
# Neon Postgres connection string (pooled). Empty locally → `npm run dev:api` uses embedded PGlite.
DATABASE_URL=
# Better Auth session secret (≥ 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public API origin used in auth links (LAN IP for a phone in development).
BETTER_AUTH_URL=http://localhost:8787
# Gemini — server-side only. Never expose to the mobile app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Transactional e-mail (password reset) via Resend — required in production.
RESEND_API_KEY=
# e.g. Bubo <nao-responda@seu-dominio.com> (domain verified in Resend)
EMAIL_FROM=
# Optional — Google Books API key (raises the shared quota). Open Library needs no key.
GOOGLE_BOOKS_API_KEY=

# ---- Mobile (Expo) — EXPO_PUBLIC_* values are embedded in the app bundle: never put secrets here ----
EXPO_PUBLIC_API_URL=http://localhost:8787

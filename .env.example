# Public ports
BUBO_PORT=8080
API_PORT=3001

# Replace before any public deployment (minimum 24 characters)
JWT_SECRET=local-development-secret-change-before-production-12345

# AI provider: auto | openai | gemini | local
AI_PROVIDER=local
AI_ALLOW_LOCAL_FALLBACK=true
AI_TIMEOUT_MS=25000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional Google Books quota key
GOOGLE_BOOKS_API_KEY=

# Optional demo seed credentials
SEED_DEMO_EMAIL=demo@bubo.local
SEED_DEMO_PASSWORD=BuboDemo123!
SEED_RESET_PASSWORD=false

# API protection
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=30

# Public ports
BUBO_PORT=8080
API_PORT=3001

# Replace before any public deployment (minimum 24 characters)
JWT_SECRET=local-development-secret-change-before-production-12345

# AI provider: auto | openai | gemini
# Deep Review requires at least one real provider key. Without a key, the rest of the app works,
# but AI validation remains explicitly unavailable and never generates a local score.
AI_PROVIDER=auto
AI_TIMEOUT_MS=30000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional Google Books quota key. Open Library remains available as a second metadata source.
GOOGLE_BOOKS_API_KEY=

# Optional demo seed credentials
SEED_DEMO_EMAIL=demo@bubo.local
SEED_DEMO_PASSWORD=BuboDemo123!
SEED_RESET_PASSWORD=false

# API protection
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=30
